# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # Static personal site, no user input. 'unsafe-inline' covers Astro's scoped
  # <style> blocks, inline style attrs, and the pre-paint theme script.
  # font-src allows data: because Vite inlines tiny font subsets as data URIs.
  # Tighten script-src to a hash if you drop the inline theme script.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Astro fingerprints these filenames (JS, CSS, fonts), so cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
