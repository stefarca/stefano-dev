---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import About from "../components/About.astro";
import Work from "../components/Work.astro";
import Stack from "../components/Stack.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
---

<Layout>
  <Hero />

  <Section id="about" index="01" title="About" eyebrow="Who's writing">
    <About />
  </Section>

  <Section
    id="work"
    index="02"
    title="Selected work"
    eyebrow="A few things I've built"
  >
    <Work />
  </Section>

  <Section id="stack" index="03" title="Stack" eyebrow="Tools I reach for">
    <Stack />
  </Section>

  <Section
    id="experience"
    index="04"
    title="Experience"
    eyebrow="Where I've worked"
  >
    <Experience />
  </Section>

  <Section id="contact" index="05" title="Contact" eyebrow="Say hello">
    <Contact />
  </Section>
</Layout>
