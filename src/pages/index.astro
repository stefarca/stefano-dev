---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import About from "../components/About.astro";
import Work from "../components/Work.astro";
import Stack from "../components/Stack.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
---

<Layout>
  <Hero />

  <div class="bento container">
    <Section id="about" title="About" eyebrow="Who's writing" full>
      <About />
    </Section>

    <Section
      id="work"
      title="Selected work"
      eyebrow="A few things I've built"
      full
    >
      <Work />
    </Section>

    <Section id="stack" title="Stack" eyebrow="Tools I reach for">
      <Stack />
    </Section>

    <Section id="experience" title="Experience" eyebrow="Where I've worked">
      <Experience />
    </Section>

    <Section id="contact" title="Contact" eyebrow="Say hello" full>
      <Contact />
    </Section>
  </div>
</Layout>

<style>
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  @media (min-width: 55rem) {
    .bento {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
