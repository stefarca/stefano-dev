---
import { stack } from "../data/stack";
---

<div class="stack">
  {stack.map((group, i) => (
    <div class="stack__group reveal" style={`--reveal-delay: ${i * 70}ms`}>
      <h3 class="stack__label">{group.label}</h3>
      <ul class="stack__items" role="list">
        {group.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .stack {
    display: grid;
    gap: var(--space-l);
  }

  .stack__group {
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-s);
    border-top: var(--border-w) solid var(--border);
  }

  .stack__label {
    font: 700 var(--step--1) / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .stack__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
  }
  .stack__items li {
    padding: 0.4rem 0.75rem;
    border: var(--border-w) solid var(--border);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-dim);
    transition:
      color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }
  .stack__items li:hover {
    color: var(--accent-ink);
    background: var(--accent-1);
  }
</style>
