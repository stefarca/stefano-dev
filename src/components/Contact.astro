---
import { profile } from "../data/profile";
---

<div class="contact">
  <p class="contact__statement reveal">
    # Have something you're building, or want to?
    <span class="accent-text">Let's talk.</span>
  </p>

  <a
    class="contact__email reveal"
    href={`mailto:${profile.email}`}
    style="--reveal-delay: 80ms"
  >
    <span class="contact__prompt">$</span> mail {profile.email}
    <span class="cursor" aria-hidden="true"></span>
  </a>

  <div class="contact__socials reveal" style="--reveal-delay: 140ms">
    <p class="contact__ls">
      <span class="contact__prompt">$</span> ls socials/
    </p>
    <ul role="list">
      {profile.socials.map((social) => (
        <li>
          <a
            href={social.href}
            target={social.href.startsWith("http") ? "_blank" : undefined}
            rel={social.href.startsWith("http") ? "noreferrer" : undefined}
          >
            <span class="contact__socials-arrow" aria-hidden="true">
              -&gt;
            </span>
            <span class="contact__socials-label">
              {social.label.toLowerCase()}
            </span>
            <span class="contact__socials-handle">{social.handle}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-l);
  }

  .contact__statement {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 24ch;
    color: var(--text-dim);
  }
  .contact__statement .accent-text {
    display: block;
    color: transparent;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: start;
    font-size: var(--step-2);
    font-family: var(--font-mono);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border-strong);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }
  .contact__email:hover {
    color: var(--accent-1);
    border-color: var(--accent-1);
  }

  .contact__prompt {
    color: var(--accent-1);
  }

  .contact__ls {
    font: 500 var(--step--1) / 1 var(--font-mono);
    color: var(--text-mute);
    margin-bottom: var(--space-s);
  }

  .contact__socials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .contact__socials a {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    min-width: 11rem;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }
  .contact__socials a:hover {
    border-color: var(--accent-1);
    background: var(--accent-soft);
  }
  .contact__socials-arrow {
    color: var(--accent-1);
    margin-right: 0.35rem;
  }
  .contact__socials-label {
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .contact__socials-handle {
    display: block;
    font-size: var(--step--1);
    color: var(--text-mute);
  }
</style>
