---
import { profile } from "../data/profile";
---

<div class="contact">
  <p class="contact__statement reveal">
    Have something you're building, or want to?
    <span class="accent-text">Let's talk.</span>
  </p>

  <a
    class="contact__email reveal"
    href={`mailto:${profile.email}`}
    style="--reveal-delay: 80ms"
  >
    {profile.email}
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path
        d="M5 12h14M13 6l6 6-6 6"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </a>

  <ul class="contact__socials reveal" role="list" style="--reveal-delay: 140ms">
    {profile.socials.map((social) => (
      <li>
        <a
          href={social.href}
          target={social.href.startsWith("http") ? "_blank" : undefined}
          rel={social.href.startsWith("http") ? "noreferrer" : undefined}
        >
          <span class="contact__socials-label">{social.label}</span>
          <span class="contact__socials-handle">{social.handle}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-l);
  }

  .contact__statement {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    max-width: 18ch;
    color: var(--text);
  }
  .contact__statement .accent-text {
    display: inline-block;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    padding: 0.8rem 1.1rem;
    border: var(--border-w) solid var(--border);
    background: var(--bg-elev-2);
    font-size: var(--step-2);
    font-family: var(--font-display);
    font-weight: 700;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .contact__email svg {
    width: 0.8em;
    height: 0.8em;
    transition: transform var(--dur) var(--ease-out);
  }
  .contact__email:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--text);
  }
  .contact__email:hover svg {
    transform: translateX(4px);
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .contact__socials a {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1.1rem;
    border: var(--border-w) solid var(--border);
    min-width: 11rem;
    transition:
      background var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .contact__socials a:hover {
    background: var(--accent-2);
    transform: translateY(-2px);
  }
  .contact__socials a:hover .contact__socials-label,
  .contact__socials a:hover .contact__socials-handle {
    color: var(--accent-ink);
  }
  .contact__socials-label {
    font: 700 var(--step--1) / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text);
    transition: color var(--dur) var(--ease-out);
  }
  .contact__socials-handle {
    font-size: var(--step--1);
    color: var(--text-mute);
    transition: color var(--dur) var(--ease-out);
  }
</style>
