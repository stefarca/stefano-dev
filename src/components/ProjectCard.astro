---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<article class="card reveal" style={`--reveal-delay: ${index * 80}ms`}>
  <div class="card__inner">
    <div class="card__meta">
      <span class="card__num">{num}</span>
      <span class="card__period">{project.period}</span>
    </div>

    <div class="card__main">
      <h3 class="card__title">
        {project.title.toLowerCase().replaceAll(" ", "-")}
        <span class="card__ext">.project</span>
      </h3>
      <p class="card__blurb"># {project.blurb}</p>
      <p class="card__detail">{project.detail}</p>

      <ul class="card__tags" role="list">
        {project.tags.map((tag) => (
          <li>--{tag.toLowerCase().replaceAll(" ", "-")}</li>
        ))}
      </ul>

      {project.links.length > 0 && (
        <div class="card__links">
          {project.links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            >
              $ open {link.label.toLowerCase()}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: color-mix(in oklab, var(--bg-elev) 62%, transparent);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }
  .card:hover {
    border-color: var(--accent-1);
    background: var(--accent-soft);
  }

  .card__inner {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--text-mute);
  }
  .card__num {
    color: var(--accent-1);
  }

  .card__title {
    font-size: var(--step-3);
    color: var(--accent-1);
  }
  .card__ext {
    color: var(--text-mute);
  }

  .card__blurb {
    font-size: var(--step-1);
    color: var(--text);
    max-width: 52ch;
  }
  .card__detail {
    color: var(--text-dim);
    max-width: 60ch;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .card__tags li {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    font: 500 0.75rem / 1 var(--font-mono);
    letter-spacing: 0.03em;
    color: var(--text-dim);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 0.5rem;
  }
  .card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: 500 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--text-dim);
    transition: color var(--dur) var(--ease-out);
  }
  .card__links a:hover {
    color: var(--accent-1);
  }

  @media (min-width: 40rem) {
    .card__inner {
      grid-template-columns: 4rem minmax(0, 1fr);
      column-gap: var(--space-l);
      align-items: start;
    }
    .card__meta {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
