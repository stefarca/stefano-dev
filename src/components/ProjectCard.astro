---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<article class="card reveal" style={`--reveal-delay: ${index * 80}ms`}>
  <div class="card__meta">
    <span class="card__num">{num}</span>
    <span class="card__period">{project.period}</span>
  </div>

  <h3 class="card__title">{project.title}</h3>
  <p class="card__blurb">{project.blurb}</p>
  <p class="card__detail">{project.detail}</p>

  <ul class="card__tags" role="list">
    {project.tags.map((tag, i) => (
      <li class:list={[i % 2 === 0 ? "card__tags--a" : "card__tags--b"]}>
        {tag}
      </li>
    ))}
  </ul>

  {project.links.length > 0 && (
    <div class="card__links">
      {project.links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
        >
          {link.label}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            aria-hidden="true"
          >
            <path
              d="M7 17 17 7M8 7h9v9"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    border: var(--border-w) solid var(--border);
    background: var(--bg);
    box-shadow: var(--shadow-1);
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--text);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    font: 700 var(--step--1) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-mute);
  }
  .card__num {
    color: var(--accent-2);
  }

  .card__title {
    font-size: var(--step-3);
  }

  .card__blurb {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
  }
  .card__detail {
    color: var(--text-dim);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .card__tags li {
    padding: 0.3rem 0.6rem;
    font: 700 0.75rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--accent-ink);
  }
  .card__tags--a {
    background: var(--accent-1);
  }
  .card__tags--b {
    background: var(--accent-2);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 0.5rem;
  }
  .card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: 700 var(--step--1) / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text);
    border-bottom: var(--border-w) solid var(--border);
    transition: border-color var(--dur) var(--ease-out);
  }
  .card__links a svg {
    width: 0.85em;
    height: 0.85em;
    transition: transform var(--dur) var(--ease-out);
  }
  .card__links a:hover {
    border-color: var(--accent-2);
  }
  .card__links a:hover svg {
    transform: translate(2px, -2px);
  }
</style>
