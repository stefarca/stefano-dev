---
import { profile } from "../data/profile";

const user = profile.name.split(" ")[0].toLowerCase();
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <p class="hero__line hero__line--cmd">
      <span class="hero__prompt">{user}@portfolio:~$</span> whoami
    </p>
    <h1 class="hero__name" aria-label={profile.name}>
      <span class="accent-text">{profile.name}</span>
    </h1>

    <p class="hero__line hero__line--cmd">
      <span class="hero__prompt">{user}@portfolio:~$</span> cat role.txt
    </p>
    <p class="hero__role">
      {profile.role} <span class="hero__sep">·</span> {profile.location}
    </p>

    <p class="hero__line hero__line--cmd">
      <span class="hero__prompt">{user}@portfolio:~$</span> cat pitch.md
    </p>
    <p class="hero__pitch">
      {profile.pitch}
      <span class="cursor" aria-hidden="true"></span>
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={`mailto:${profile.email}`}>
        get in touch
      </a>
      <a
        class="btn btn--ghost"
        href={profile.socials[0].href}
        target="_blank"
        rel="noreferrer"
      >
        {profile.socials[0].label.toLowerCase()}
      </a>
      {profile.resume && (
        <a class="btn btn--ghost" href={profile.resume}>
          résumé
        </a>
      )}
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to about">
    [ scroll ↓ ]
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 7rem var(--space-xl);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .hero__line {
    font: 500 var(--step--1) / 1.4 var(--font-mono);
    color: var(--text-mute);
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) forwards;
  }
  .hero__line:nth-of-type(1) {
    animation-delay: 0.05s;
  }
  .hero__prompt {
    color: var(--accent-1);
  }

  .hero__name {
    margin-block: 0.15rem var(--space-s);
    font-size: var(--step-6);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    opacity: 0;
    animation: hero-in 0.7s var(--ease-out) 0.15s forwards;
    text-shadow: 0 0 28px var(--glow);
  }

  .hero__role {
    margin-block: 0.15rem var(--space-s);
    font-size: var(--step-1);
    color: var(--text-dim);
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) 0.3s forwards;
  }
  .hero__sep {
    color: var(--accent-2);
    margin-inline: 0.3rem;
  }

  .hero__pitch {
    max-width: 52ch;
    margin-block: 0.15rem var(--space-m);
    font-size: var(--step-1);
    color: var(--text-dim);
    line-height: 1.55;
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) 0.5s forwards;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-s);
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) 0.65s forwards;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    translate: -50% 0;
    color: var(--text-mute);
    font: 500 var(--step--1) / 1 var(--font-mono);
    opacity: 0;
    animation: hero-in 0.8s var(--ease-out) 0.9s forwards;
    transition: color var(--dur) var(--ease-out);
  }
  .hero__scroll:hover {
    color: var(--accent-1);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__name,
    .hero__role,
    .hero__pitch,
    .hero__actions,
    .hero__scroll {
      opacity: 1;
      animation: none;
    }
  }
</style>
