---
import { profile } from "../data/profile";

const [firstName, ...rest] = profile.name.split(" ");
const lastName = rest.join(" ");
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">
      {profile.role} — {profile.location}
    </p>

    <h1 class="hero__name" aria-label={profile.name}>
      <span class="hero__name-line" aria-hidden="true">
        {firstName}
      </span>
      <span class="hero__name-line" aria-hidden="true">
        <span class="accent-text">{lastName}</span>
      </span>
    </h1>

    <p class="hero__pitch">{profile.pitch}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={`mailto:${profile.email}`}>
        Get in touch
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          aria-hidden="true"
        >
          <path
            d="M5 12h14M13 6l6 6-6 6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
      <a
        class="btn btn--ghost"
        href={profile.socials[0].href}
        target="_blank"
        rel="noreferrer"
      >
        {profile.socials[0].label}
      </a>
      {profile.resume && (
        <a class="btn btn--ghost" href={profile.resume}>
          Résumé
        </a>
      )}
    </div>
  </div>

  <a class="hero__scroll btn" href="#about" aria-label="Scroll to about">
    ↓
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 7rem var(--space-xl);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }

  .hero__eyebrow {
    background: var(--bg-elev);
    opacity: 0;
    animation: hero-in 0.5s var(--ease-out) 0.05s forwards;
  }

  .hero__name {
    font-size: var(--step-6);
    line-height: 0.88;
  }
  .hero__name-line {
    display: block;
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) forwards;
  }
  .hero__name-line:nth-child(1) {
    animation-delay: 0.1s;
  }
  .hero__name-line:nth-child(2) {
    animation-delay: 0.18s;
  }

  .hero__pitch {
    max-width: 42ch;
    font-size: var(--step-2);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-dim);
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) 0.3s forwards;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-s);
    opacity: 0;
    animation: hero-in 0.6s var(--ease-out) 0.42s forwards;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    translate: -50% 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    justify-content: center;
    font-size: var(--step-1);
    opacity: 0;
    animation:
      hero-in 0.7s var(--ease-out) 0.6s forwards,
      scroll-bob 1.6s var(--ease-in-out) 0.6s infinite;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes scroll-bob {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 6px);
    }
  }

  @media (max-width: 40rem) {
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__name-line,
    .hero__pitch,
    .hero__actions,
    .hero__scroll {
      opacity: 1;
      animation: none;
    }
  }
</style>
