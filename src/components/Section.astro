---
interface Props {
  id: string;
  index: string;
  title: string;
  eyebrow?: string;
}

const { id, index, title, eyebrow } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container section__grid">
    <div class="section__index" aria-hidden="true">
      <span class="section__index-num">{index}</span>
      <span class="section__index-line"></span>
    </div>

    <header class="section__head reveal">
      {eyebrow && <p class="eyebrow">// {eyebrow}</p>}
      <h2 class="section__title" id={`${id}-title`}>
        <span class="section__prompt" aria-hidden="true">
          $
        </span>
        {title.toLowerCase()}
      </h2>
    </header>

    <div class="section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3.25rem, 1.5rem + 7vw, 6rem);
    scroll-margin-top: 5rem;
  }

  .section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
  }

  .section__index {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font: 500 var(--step--1) / 1 var(--font-mono);
    color: var(--text-mute);
    letter-spacing: 0.02em;
  }
  .section__index-num::before {
    content: "L";
  }
  .section__index-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .section__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step-4);
    margin-top: 0.25rem;
    text-transform: none;
  }
  .section__prompt {
    color: var(--accent-1);
  }

  .section__body {
    margin-top: var(--space-m);
  }

  @media (min-width: 60rem) {
    .section__grid {
      grid-template-columns: 5rem minmax(0, 1fr);
      column-gap: var(--space-xl);
      row-gap: var(--space-l);
    }
    .section__index {
      grid-row: 1 / 3;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
      position: sticky;
      top: 6.5rem;
      align-self: start;
      height: max-content;
    }
    .section__index-line {
      width: 1px;
      height: clamp(3rem, 12vh, 7rem);
      flex: none;
    }
    .section__head,
    .section__body {
      grid-column: 2;
    }
    .section__body {
      margin-top: 0;
    }
  }
</style>
