---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  full?: boolean;
}

const { id, title, eyebrow, full = false } = Astro.props;
---

<section
  class:list={["tile", { "tile--full": full }]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <header class="tile__head reveal">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="tile__title" id={`${id}-title`}>
      {title}
    </h2>
  </header>

  <div class="tile__body">
    <slot />
  </div>
</section>

<style>
  .tile {
    scroll-margin-top: 6rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    border: var(--border-w) solid var(--border);
    background: var(--bg-elev);
    box-shadow: var(--shadow-2);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }

  .tile--full {
    grid-column: 1 / -1;
  }

  .tile__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .tile__title {
    font-size: var(--step-4);
    border-bottom: var(--border-w) solid var(--accent-1);
    padding-bottom: 0.25em;
  }
</style>
