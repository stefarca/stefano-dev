---
import { experience } from "../data/experience";
---

<ol class="timeline" role="list">
  {experience.map((job, i) => (
    <li class="timeline__item reveal" style={`--reveal-delay: ${i * 80}ms`}>
      <div class="timeline__marker" aria-hidden="true" />
      <div class="timeline__period">
        <span>{job.start}</span>
        <span class="timeline__dash">—</span>
        <span>{job.end}</span>
      </div>
      <div class="timeline__body">
        <h3 class="timeline__role">
          {job.role} <span class="timeline__org">· {job.org}</span>
        </h3>
        <p class="timeline__summary">{job.summary}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    display: grid;
    gap: var(--space-l);
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-m);
    row-gap: 0.5rem;
    padding-left: 1.5rem;
  }

  .timeline__marker {
    position: absolute;
    left: -2px;
    top: 0.4rem;
    width: 11px;
    height: 11px;
    background: var(--accent-1);
    border: var(--border-w) solid var(--border);
  }
  .timeline__item::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 1.3rem;
    bottom: -1.9rem;
    width: var(--border-w);
    background: var(--border);
  }
  .timeline__item:last-child::before {
    display: none;
  }

  .timeline__period {
    font: 700 var(--step--1) / 1.4 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--text-mute);
    white-space: nowrap;
  }
  .timeline__dash {
    margin-inline: 0.3rem;
  }

  .timeline__role {
    font-size: var(--step-1);
    font-family: var(--font-display);
  }
  .timeline__org {
    color: var(--accent-2);
    font-weight: 700;
    text-transform: none;
  }
  .timeline__summary {
    margin-top: 0.35rem;
    color: var(--text-dim);
    max-width: 58ch;
  }

  @media (max-width: 40rem) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }
</style>
