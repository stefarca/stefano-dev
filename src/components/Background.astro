---
/**
 * Fixed phosphor dot-grid field rendered on a <canvas>, plus static CRT
 * scanlines. Pointer proximity brightens and swells nearby dots.
 * Honours prefers-reduced-motion: a single static grid, no loop, no listeners.
 */
---

<div class="bg" aria-hidden="true">
  <canvas class="bg__grid" data-dot-grid></canvas>
  <div class="bg__scanlines"></div>
  <div class="bg__vignette"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: var(--z-background);
    pointer-events: none;
    overflow: hidden;
    background: var(--bg);
  }

  .bg__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  .bg__scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.22) 0,
      rgba(0, 0, 0, 0.22) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: multiply;
    opacity: 0.35;
    animation: scanline-drift 9s linear infinite;
  }

  .bg__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 80% at 50% 0%,
      transparent 40%,
      color-mix(in oklab, var(--bg) 70%, transparent) 100%
    );
  }

  :root[data-theme="light"] .bg__scanlines {
    opacity: 0.12;
  }
  :root[data-theme="light"] .bg__grid {
    opacity: 0.7;
  }

  @keyframes scanline-drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg__scanlines {
      animation: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-dot-grid]");
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const GAP = 34; // px between dots
    const BASE_R = 1; // px radius at rest
    const REACH = 150; // px pointer influence radius

    let width = 0;
    let height = 0;
    let dpr = 1;
    let accent = "137, 221, 255";
    const pointer = { x: -9999, y: -9999, active: false };
    let raf = 0;
    let idleFrames = 0;

    const readAccent = () => {
      const raw = getComputedStyle(document.documentElement)
        .getPropertyValue("--accent-1")
        .trim();
      const probe = document.createElement("span");
      probe.style.color = raw;
      document.body.appendChild(probe);
      const rgb = getComputedStyle(probe).color.match(/\d+/g);
      probe.remove();
      if (rgb && rgb.length >= 3) accent = rgb.slice(0, 3).join(", ");
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      const dark = document.documentElement.dataset.theme !== "light";
      const baseAlpha = dark ? 0.16 : 0.22;
      const rest = dark ? "255, 255, 255" : "16, 16, 28";

      for (let y = GAP; y < height; y += GAP) {
        for (let x = GAP; x < width; x += GAP) {
          let r = BASE_R;
          let alpha = baseAlpha;
          let colour = rest;

          if (pointer.active) {
            const dx = x - pointer.x;
            const dy = y - pointer.y;
            const dist = Math.hypot(dx, dy);
            if (dist < REACH) {
              const f = 1 - dist / REACH;
              r = BASE_R + f * f * 2.6;
              alpha = baseAlpha + f * f * (dark ? 0.6 : 0.5);
              colour = accent;
            }
          }

          ctx.beginPath();
          ctx.fillStyle = `rgba(${colour}, ${alpha})`;
          ctx.arc(x, y, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };

    const loop = () => {
      draw();
      // stop the loop once things have settled after the pointer left
      idleFrames = pointer.active ? 0 : idleFrames + 1;
      if (idleFrames > 30) {
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(loop);
    };

    const kick = () => {
      idleFrames = 0;
      if (!raf) raf = requestAnimationFrame(loop);
    };

    resize();
    readAccent();

    if (reduceMotion) {
      draw();
    } else {
      window.addEventListener(
        "pointermove",
        (e) => {
          if (e.pointerType === "touch") return;
          pointer.x = e.clientX;
          pointer.y = e.clientY;
          pointer.active = true;
          kick();
        },
        { passive: true },
      );

      window.addEventListener("pointerleave", () => {
        pointer.active = false;
        kick();
      });

      window.addEventListener(
        "resize",
        () => {
          resize();
          kick();
        },
        { passive: true },
      );

      new MutationObserver(() => {
        readAccent();
        kick();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      draw();
    }
  }
</script>
