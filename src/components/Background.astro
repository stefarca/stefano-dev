---
/**
 * Flat, static graph-paper grid. No motion, no canvas — brutalism stays raw.
 */
---

<div class="bg" aria-hidden="true">
  <div class="bg__grid"></div>
  <div class="bg__block bg__block--a"></div>
  <div class="bg__block bg__block--b"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: var(--z-background);
    pointer-events: none;
    overflow: hidden;
    background: var(--bg);
  }

  .bg__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.12;
  }

  .bg__block {
    position: absolute;
    border: var(--border-w) solid var(--border);
  }
  .bg__block--a {
    top: 8vh;
    right: -6vw;
    width: 34vw;
    height: 34vw;
    max-width: 26rem;
    max-height: 26rem;
    background: var(--accent-1);
    opacity: 0.9;
    rotate: 8deg;
  }
  .bg__block--b {
    bottom: -10vw;
    left: -8vw;
    width: 28vw;
    height: 28vw;
    max-width: 20rem;
    max-height: 20rem;
    background: var(--accent-2);
    opacity: 0.14;
    rotate: -6deg;
  }

  :root[data-theme="light"] .bg__grid {
    opacity: 0.16;
  }
  :root[data-theme="light"] .bg__block--a {
    opacity: 0.8;
  }
</style>
